# ==============================================================================
# Pombo CDN - Environment Configuration (.env.example)
# Copy this file to .env and adjust the values for your production deployment.
# ==============================================================================

# Security
# Set a unique, cryptographically strong random string in production!
SECRET_KEY=pombo-change-this-to-a-secure-random-token-in-production

# Debug Mode (0 = Disabled for production, 1 = Enabled for local dev only)
DEBUG=0

# Allowed HTTP Hosts (Comma-separated hostnames or '*' for any host)
# Example: ALLOWED_HOSTS=cdn.seudominio.com,localhost,127.0.0.1
ALLOWED_HOSTS=*

# CSRF Trusted Origins (Comma-separated full URLs with scheme and port)
# Required when accessing via HTTPS or a custom reverse proxy domain!
# Example: CSRF_TRUSTED_ORIGINS=https://cdn.seudominio.com,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Initial Super Administrator Credentials
# Automatically created on container boot if no users exist.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123
ADMIN_EMAIL=admin@pombo.local

# Default Language
# 'en' for US English (default), or 'pt-br' for Brazilian Portuguese.
# Users can also toggle their language in real-time via the top bar.
DEFAULT_LANGUAGE=en

# Storage Directories
# Defaults map to /app/storage/uploads and /app/storage/external inside Docker.
# UPLOAD_STORAGE_DIR=/app/storage/uploads
# EXTERNAL_STORAGE_DIR=/app/storage/external

# Database Configuration (Optional)
# By default, Pombo uses high-performance persistent SQLite with WAL mode.
# If you prefer PostgreSQL or MySQL in production, uncomment and set DATABASE_URL:
# DATABASE_URL=postgres://pombo_user:strong_password@postgres_host:5432/pombo_db

# Nginx X-Accel Acceleration
# 1 = Use Nginx X-Accel-Redirect for ultra-fast streaming (default in Docker)
# 0 = Fallback to Django FileResponse (only needed if running outside Docker/Nginx)
USE_X_ACCEL=1
